{
    "name": "zalo-api-service",
    "productName": "Zalo API Service",
    "version": "1.0.0",
    "main": "main.js",
    "description": "Phần mềm tự động hóa Zalo qua API",
    "author": "IT Team",
    "license": "ISC",
    "scripts": {
        "start": "electron .",
        "build": "npx electron-packager . \"Zalo API Service\" --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite"
    },
    "build": {
        "appId": "com.company.zaloapiservice",
        "win": {
            "target": "portable"
        },
        "directories": {
            "output": "dist"
        }
    },
    "dependencies": {
        "express": "^5.2.1",
        "playwright": "^1.63.0",
        "png-to-ico": "^3.0.2",
        "sharp": "^0.35.4"
    },
    "devDependencies": {
        "electron": "^41.7.1",
        "electron-builder": "^24.13.3"
    }
}
